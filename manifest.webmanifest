{
  "name": "Ledger trading journal",
  "short_name": "Ledger",
  "description": "Private futures and CFD trading journal. Data stays on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0E1B26",
  "theme_color": "#0E1B26",
  "orientation": "any",
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Log a trade", "url": "./#trades", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Journal", "url": "./#journal", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Import", "url": "./#import", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192"}]}
  ]
}
